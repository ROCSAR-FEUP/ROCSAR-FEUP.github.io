---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "ROCSAR — a compact 5.8 GHz Synthetic Aperture Radar payload developed for the ESA REXUS/BEXUS stratospheric balloon programme." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(`${base}/images/LogoROCSAR.png`, Astro.site ?? Astro.url.origin).href;

const navLinks = [
  { href: `${base}/`, label: "The Project", path: "/" },
  { href: `${base}/team/`, label: "The Team", path: "/team" },
  { href: `${base}/history/`, label: "History", path: "/history" },
  { href: `${base}/results/`, label: "Results", path: "/results" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ROCSAR" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="navbar">
      <div class="nav-container">
        <a href={`${base}/`} class="nav-logo" aria-label="ROCSAR home">
          <img src={`${base}/images/LogoROCSAR.png`} alt="ROCSAR" width="32" height="32" />
        </a>
        <nav aria-label="Primary">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={currentPath === link.path ? "active" : ""}
              aria-current={currentPath === link.path ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <nav aria-label="Footer">
        {navLinks.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <p>
        &copy; 2026 ROCSAR Payload Experiment &bull; ESA
        <a href="https://rexusbexus.net" target="_blank" rel="noopener noreferrer">REXUS/BEXUS</a> Program
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #0d0f14;
    --card-bg: rgba(21, 25, 34, 0.6);
    --card-border: rgba(255, 255, 255, 0.08);
    --card-border-hover: rgba(255, 255, 255, 0.22);
    --text-primary: #f8fafc;
    --text-secondary: #8b99a8;
    --accent-slate: #cbd5e1;
    --accent-muted: #64748b;
    --tag-bg: rgba(255, 255, 255, 0.03);
  }

  * {
    box-sizing: border-box;
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 200;
    background: var(--text-primary);
    color: var(--bg-color);
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 0;
  }

  body {
    margin: 0;
    background-color: var(--bg-color);
    background-image: radial-gradient(circle at 50% -10%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
    background-attachment: fixed;
    color: var(--text-primary);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  /* Navbar */
  .navbar {
    border-bottom: 1px solid var(--card-border);
    background: rgba(13, 15, 20, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .nav-logo img {
    display: block;
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  nav a:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--card-border);
  }

  nav a.active {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--card-border);
  }

  /* Layout */
  main {
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    flex: 1;
  }

  footer {
    border-top: 1px solid var(--card-border);
    text-align: center;
    padding: 2.25rem 1.5rem;
    color: var(--accent-muted);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  footer nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-bottom: 1rem;
  }

  footer nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  footer nav a:hover {
    color: var(--text-primary);
  }

  footer p {
    margin: 0;
  }

  footer a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  footer a:hover {
    color: var(--text-primary);
  }

  /* Shared section styles */
  .section {
    margin-bottom: 4.5rem;
  }

  .section-header h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 1.75rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    letter-spacing: -0.01em;
  }

  .section-header h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--card-border);
  }

  /* Shared card styles */
  .grid-3 {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .glass-card {
    background: var(--card-bg);
    padding: 1.75rem;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .glass-card:hover {
    border-color: var(--card-border-hover);
    transform: translateY(-2px);
  }

  .glass-card h2,
  .glass-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .glass-card p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0;
    font-weight: 300;
  }

  .glass-card .date {
    display: block;
    font-size: 0.73rem;
    color: var(--accent-muted);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  /* Shared highlight list */
  .highlight-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .highlight-item {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    font-weight: 300;
    position: relative;
    padding-left: 2.5rem;
    transition: border-color 0.2s ease;
  }

  .highlight-item::before {
    content: '';
    position: absolute;
    left: 1.1rem;
    top: 1.45rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-slate);
  }

  .highlight-item:hover {
    border-color: var(--card-border-hover);
  }
</style>
