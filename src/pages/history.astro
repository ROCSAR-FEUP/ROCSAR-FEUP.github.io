---
import Layout from '../layouts/Layout.astro';
import { HISTORY_PROJECTS } from '../data';
---

<Layout title="Mission History | ROCSAR Payload Experiment">
  <header class="header">
    <h1 class="title">Mission History</h1>
    <p>Prior stratospheric payloads at DEEC that paved the way for ROCSAR.</p>
  </header>

  <section class="section">
    <div class="grid-3">
      {HISTORY_PROJECTS.map(proj => (
        <div class="glass-card">
          <h2>{proj.name}</h2>
          <p><span class="date">{proj.year}</span>{proj.description}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .header p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-top: 0;
    font-weight: 300;
  }
</style>
