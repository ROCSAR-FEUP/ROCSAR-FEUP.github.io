---
import Layout from '../layouts/Layout.astro';
import { PROJECT_RESULTS } from '../data';
---

<Layout title="Mission Results | ROCSAR Payload Experiment">
  <header class="header">
    <h1 class="title">Mission Results</h1>
    <p>Post-flight outcomes from the ROCSAR campaign aboard BEXUS.</p>
  </header>

  <section class="section">
    <div class="section-header">
      <h2>Highlights</h2>
    </div>
    <div class="highlight-list">
      {PROJECT_RESULTS.highlights.map(highlight => (
        <div class="highlight-item">{highlight}</div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Summary</h2>
    </div>
    <p class="summary">{PROJECT_RESULTS.summary}</p>
  </section>
</Layout>

<style>
  .header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .header p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-top: 0;
    font-weight: 300;
  }
  .summary {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    font-weight: 300;
    margin: 0;
    max-width: 720px;
  }
</style>
